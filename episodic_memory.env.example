# Copy this file to .env in the same directory as the orchestrator.
# Do not put spaces around '='. You do not need to run `source .env`.

# -----------------------------------------------------------------------------
# OpenCode
# -----------------------------------------------------------------------------
OPENCODE_API_KEY="replace-with-your-opencode-key"
OPENCODE_BIN="opencode"

# -----------------------------------------------------------------------------
# Langfuse
# -----------------------------------------------------------------------------
LANGFUSE_PUBLIC_KEY="replace-with-your-langfuse-public-key"
LANGFUSE_SECRET_KEY="replace-with-your-langfuse-secret-key"
LANGFUSE_BASE_URL="https://us.cloud.langfuse.com"

# -----------------------------------------------------------------------------
# LLM used only to turn one completed Langfuse trace into one episode
# -----------------------------------------------------------------------------
EPISODE_LLM_MODEL="deepseek-v4-flash-free"
EPISODE_LLM_BASE_URL="https://opencode.ai/zen/v1"
EPISODE_LLM_API_KEY="replace-with-your-opencode-key"
EPISODE_DIR=".episodic_memory"

# -----------------------------------------------------------------------------
# PostgreSQL + Apache AGE
# The supplied docker-compose.yml exposes AGE PostgreSQL on localhost:5455.
# -----------------------------------------------------------------------------
POSTGRES_USER="postgres"
POSTGRES_PASSWORD="postgres"
POSTGRES_DB="episodic_memory_db"
POSTGRES_PORT="5455"

MEMORY_DATABASE_URL="postgresql://postgres:postgres@localhost:5455/episodic_memory_db"
MEMORY_ADMIN_DB="postgres"
MEMORY_GRAPH_NAME="episodic_memory"
